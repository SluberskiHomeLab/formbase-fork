# Copy to .env to override defaults:
#
#   cp .env.example .env
#
# Everything here is optional -- `docker compose up -d` works with no .env at
# all. Every variable below is passed through by docker-compose.yml; the two
# files are kept in step, so if you add one here add it there too.
#
# Commented out == the app's built-in default applies. Uncomment only what you
# actually want to change.


# --- Host port ---------------------------------------------------------------
# Which port to publish on the host. Used by the `ports:` mapping in
# docker-compose.yml, NOT passed into the container -- the app always listens
# on 3000 inside. (PORT and DATA_DIR are fixed in the Dockerfile and are
# deliberately not overridable here.)
FORMBASE_PORT=3000


# --- Signing secret ------------------------------------------------------------
# Unset: a random secret is generated into the data volume on first run and
# reused across restarts. Set it explicitly if you run more than one replica,
# or each will issue tokens the others reject. Minimum 32 characters:
#   openssl rand -hex 32
# JWT_SECRET=

# How long a login stays valid. Default: 7d
# JWT_EXPIRES_IN=7d


# --- Behind a reverse proxy ------------------------------------------------------
# Set to 1 ONLY if Traefik / nginx / Caddy actually sits in front of FormBase.
#
# It tells the app to believe the X-Forwarded-For header. With a real proxy in
# front, that is what makes rate limiting see the true client IP instead of
# throttling all your users as one.
#
# With NO proxy in front, it is actively harmful: anyone can send their own
# X-Forwarded-For and get a fresh rate-limit bucket per request. Measured on
# this codebase with TRUST_PROXY=1 and no proxy -- 80 login attempts across
# distinct accounts with zero throttling (limit is 10), and 100 submissions to
# one form (limit is 30).
#
# Leave commented unless you are certain. Safe default is off.
# TRUST_PROXY=1


# --- Dashboard origin --------------------------------------------------------------
# Only needed when the dashboard is served from a different origin than the API.
# The normal same-origin deployment needs nothing here.
# Default: same-origin only (no Access-Control-Allow-Origin emitted).
# CORS_ORIGIN=https://forms.example.com


# --- Webhooks --------------------------------------------------------------------
# Webhooks to private / loopback / link-local addresses are blocked by default
# to prevent server-side request forgery. Set to 1 only if your webhook target
# genuinely is on your own network (homelab, LAN service). Default: blocked.
# SSRF_ALLOW_PRIVATE=1


# --- Rate limits -------------------------------------------------------------------
# Defaults suit an instance on the public internet. Raise them if many of your
# users share one source IP -- office NAT, VPN, CGNAT.
# RATE_LIMIT_AUTH_IP=10           # auth attempts per IP per 15 min       (default 10)
# RATE_LIMIT_AUTH_ACCOUNT=5       # auth attempts per account per 15 min  (default 5)
# RATE_LIMIT_SUBMIT=30            # submissions per IP per form per min   (default 30)
# RATE_LIMIT_API=300              # API requests per IP per min           (default 300)


# --- Email notifications -----------------------------------------------------------
# Without SMTP_HOST, notifications are written to the log rather than sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                   # default 587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com   # default noreply@formbase.dev

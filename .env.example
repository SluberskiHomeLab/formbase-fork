# Copy to .env to override defaults:
#
#   cp .env.example .env
#
# Everything here is optional -- `docker compose up -d` works with no .env at
# all. Every variable below is passed through by docker-compose.yml; the two
# files are kept in step, so if you add one here add it there too.
#
# Commented out == the app's built-in default applies. Uncomment only what you
# actually want to change.


# --- Host port ---------------------------------------------------------------
# Which port to publish on the host. Used by the `ports:` mapping in
# docker-compose.yml, NOT passed into the container -- the app always listens
# on 3000 inside. (PORT and DATA_DIR are fixed in the Dockerfile and are
# deliberately not overridable here.)
FORMBASE_PORT=3000


# --- Registration ------------------------------------------------------------
# Set to 1 to close public sign-up. POST /api/auth/register then returns 403 for
# everyone, unconditionally, and the dashboard hides the sign-up form. Existing
# accounts are unaffected and keep working.
#
# Accounts are still created afterwards -- an admin makes them from the Users
# page in the dashboard, or via POST /api/admin/users.
#
# Default: registration open.
# DISABLE_REGISTRATION=1


# --- First admin -------------------------------------------------------------
# The first account created on an instance is automatically an admin, so the
# normal path is: leave these unset, open the dashboard, sign up, then set
# DISABLE_REGISTRATION=1 and restart.
#
# These two exist for the other order -- bringing up an instance with
# DISABLE_REGISTRATION already on, where nobody could otherwise sign up and
# there is no admin yet to create accounts. Both must be set together.
#
# They are applied ONLY when the database has no users at all, so they cannot
# overwrite or resurrect an account on an instance already in use. Once the
# admin exists, change the password from the dashboard's Account page and
# remove ADMIN_PASSWORD from here.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=


# --- Signing secret ------------------------------------------------------------
# Unset: a random secret is generated into the data volume on first run and
# reused across restarts. Set it explicitly if you run more than one replica,
# or each will issue tokens the others reject. Minimum 32 characters:
#   openssl rand -hex 32
# JWT_SECRET=

# How long a login stays valid. Default: 7d
# JWT_EXPIRES_IN=7d


# --- Behind a reverse proxy ------------------------------------------------------
# Set to 1 ONLY if Traefik / nginx / Caddy actually sits in front of FormBase.
#
# It tells the app to believe the X-Forwarded-For header. With a real proxy in
# front, that is what makes rate limiting see the true client IP instead of
# throttling all your users as one.
#
# With NO proxy in front, it is actively harmful: anyone can send their own
# X-Forwarded-For and get a fresh rate-limit bucket per request. Measured on
# this codebase with TRUST_PROXY=1 and no proxy -- 80 login attempts across
# distinct accounts with zero throttling (limit is 10), and 100 submissions to
# one form (limit is 30).
#
# Leave commented unless you are certain. Safe default is off.
# TRUST_PROXY=1


# --- HTTPS -----------------------------------------------------------------------
# Set to 1 ONLY when FormBase is actually reachable over https -- either behind
# a proxy that terminates TLS, or with its own certificate.
#
# It enables HSTS and the CSP's upgrade-insecure-requests directive. Enabling
# it WITHOUT working TLS makes the dashboard load blank on every address except
# localhost: the browser is told to fetch /app.js over https, nothing answers,
# and the script never loads.
#
# Leave commented for plain-HTTP access over a LAN or by IP. Default: off.
# FORCE_HTTPS=1


# --- Dashboard origin --------------------------------------------------------------
# Only needed when the dashboard is served from a different origin than the API.
# The normal same-origin deployment needs nothing here.
# Default: same-origin only (no Access-Control-Allow-Origin emitted).
# CORS_ORIGIN=https://forms.example.com


# --- Webhooks --------------------------------------------------------------------
# Webhooks to private / loopback / link-local addresses are blocked by default
# to prevent server-side request forgery. Set to 1 only if your webhook target
# genuinely is on your own network (homelab, LAN service). Default: blocked.
# SSRF_ALLOW_PRIVATE=1


# --- Rate limits -------------------------------------------------------------------
# Defaults suit an instance on the public internet. Raise them if many of your
# users share one source IP -- office NAT, VPN, CGNAT.
# RATE_LIMIT_AUTH_IP=10           # auth attempts per IP per 15 min       (default 10)
# RATE_LIMIT_AUTH_ACCOUNT=5       # auth attempts per account per 15 min  (default 5)
# RATE_LIMIT_SUBMIT=30            # submissions per IP per form per min   (default 30)
# RATE_LIMIT_API=300              # API requests per IP per min           (default 300)


# --- Email notifications -----------------------------------------------------------
# Without SMTP_HOST, notifications are written to the log rather than sent.
#
# SMTP_FROM is the one that catches people out. Relays only send as addresses
# they are authoritative for, so a From on someone else's domain is answered
# with `553 Sender is not allowed to relay emails` and the notification is
# silently lost. Set it to an address on YOUR domain -- normally the same
# address as SMTP_USER. If you leave it unset, SMTP_USER is used when it looks
# like an email address.
#
# The configuration is checked at startup: look for a `[mail] ready: ...` line
# in the logs, or an error saying exactly what to change.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                   # default 587
# SMTP_USER=you@example.com
# SMTP_PASS=                      # many providers need an app-specific password
# SMTP_FROM=you@example.com       # must be an address your relay may send as
#
# Implicit TLS (port 465) vs STARTTLS (587/25) is inferred from SMTP_PORT.
# Only set this if your relay does something unusual.
# SMTP_SECURE=1
